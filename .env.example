# Copy to .env (gitignored). Existing environment variables take precedence.

# Google Places API (New) — prospector "google": rich leads with photos + reviews
GOOGLE_MAPS_API_KEY=

# VIGNO app sync — when set, pitched leads land in the vigno.ca CRM and demos
# publish behind https://vigno.ca/d/<token>. The key lives in the app's
# websmith_config table (database function public.websmith_ingest checks it).
VIGNO_WEBSMITH_KEY=

# Only needed if the app's Supabase project ever changes (defaults are the
# app's public client values, baked into src/sync/vigno.js):
# VIGNO_SUPABASE_URL=
# VIGNO_SUPABASE_ANON_KEY=

# Auto-send (outreach.autoSend) — Gmail app password for the operator email
# (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_PASSWORD=
